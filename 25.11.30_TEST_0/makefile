# Компилятор (g++ по умолчанию, но CI может подменить его)
CXX ?= g++

# Флаги компиляции
# ?= позволяет CI перезаписать эти флаги (например, добавить санитайзеры)
CXXFLAGS ?= -std=c++17 -Wall -Wextra -Werror

# Имя итогового исполняемого файла
TARGET = main

# Автоматический поиск всех .cpp файлов в текущей папке
SRCS = $(wildcard *.cpp)

# Превращаем список .cpp файлов в список .o файлов
OBJS = $(SRCS:.cpp=.o)

# Цель по умолчанию
all: $(TARGET)

# Линковка (сборка .o файлов в программу)
# Важно: $(CXXFLAGS) должны быть и здесь, чтобы санитайзеры работали корректно
$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $(TARGET)

# Компиляция каждого .cpp в .o
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Очистка (удаление бинарников и объектных файлов)
clean:
	rm -f $(OBJS) $(TARGET)